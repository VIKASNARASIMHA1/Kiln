# Copy to .env and fill in. Never commit the real .env.

# --- Required in production ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Language model for the tutor and AI-written quizzes (optional) ---
# Leave LLM_PROVIDER empty and the app runs in demo mode: the tutor shows matching lesson
# passages and quizzes come from the built-in question bank. Choose one provider:
#   ollama     FREE. Runs a model on your own computer. Install Ollama, run "ollama pull llama3.2",
#              then set LLM_PROVIDER=ollama. Check it with: cd server && npm run check:llm
#   anthropic  Claude through the Anthropic API. Needs ANTHROPIC_API_KEY and account credits.
#   openai     Any OpenAI-compatible service (LM Studio, or hosted services; some have free tiers,
#              check their current limits). Needs LLM_BASE_URL and LLM_MODEL (and LLM_API_KEY if hosted).
LLM_PROVIDER=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Optional. How long to wait for the model's FIRST word, in milliseconds. Default 180000 (3 minutes) for
# Ollama, because the model may still be loading. After it starts, it may go silent for 60 seconds at most.
LLM_TIMEOUT_MS=
# Ollama keeps the model in memory this long after its last use, so only the first question is slow.
OLLAMA_KEEP_ALIVE=30m
# Load the model when the API starts (1) so the first question is quick. Set 0 to load it on first use.
OLLAMA_WARMUP=1
# AI-written quizzes: empty = automatic (on for hosted models, off for local ones because they are slow).
# Set 1 to have a local model write quizzes (slower, 3 questions), or 0 to always use the question bank.
QUIZ_USE_LLM=

# --- Database (PostgreSQL) ---
# Local Postgres, e.g.  createdb kiln  (or:  docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiln
# On Neon, paste the connection string from the dashboard (Connect > pooled connection), for example:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# TLS is switched on automatically for anything that is not localhost. DATABASE_SSL=0 / 1 forces it off / on.
DATABASE_SSL=
# Fill an empty database with courses, lessons and simulated learners when the API starts (1 = yes).
# The tables themselves are always created automatically. Used on Render; locally you can run: npm run seed
AUTO_SEED=

# --- Local development (defaults shown) ---
AI_SERVICE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
# Max tutor questions per user per 10 minutes (protects your API bill if you use a paid model)
TUTOR_LIMIT_PER_10_MIN=20

# --- Code exercises (sandboxed runner inside the AI service) ---
# Set SANDBOX_ENABLED=0 to switch code execution off entirely.
SANDBOX_ENABLED=1
# Shared secret between the API and the AI service. Set the same value for both in production.
SANDBOX_TOKEN=
# Max code runs per user per 10 minutes
RUN_LIMIT_PER_10_MIN=40
